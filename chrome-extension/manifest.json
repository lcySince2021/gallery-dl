{
  "manifest_version": 3,
  "name": "Gallery-DL Downloader",
  "version": "1.0",
  "description": "一键下载 Twitter/X、Instagram 媒体：发送到 Telegram Bot 或直接保存到本地",
  "permissions": [
    "activeTab",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://192.168.123.7:8088/*",
    "https://cdn.syndication.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "发送到 Gallery-DL"
  },
  "options_page": "options.html"
}
